## Alternate Approach to create keyrings
# ceph-authtool \
# --create-keyring /etc/ceph/ceph.client.admin.keyring \
# --gen-key -n client.admin \
# --cap mon 'allow *' \
# --cap mgr 'allow *' \
# --cap osd 'allow *' \
# --cap mds 'allow *'
# The keyring is "not" a symetric encoding

[client.admin]
        key = AQAnIxZoSkk6KhAASHgqFv3MOn6mAlGD6xZcfA==
        caps mds = "allow *"
        caps mgr = "allow *"
        caps mon = "allow *"
        caps osd = "allow *"
