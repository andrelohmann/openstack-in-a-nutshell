# ceph-authtool \
# --create-keyring /opt/ceph.mon.keyring \
# --gen-key -n mon. \
# --cap mon 'allow *'
#
# ceph-authtool \
# /opt/ceph.mon.keyring \
# --import-keyring /etc/ceph/ceph.client.admin.keyring
[mon.]
        key = AQADMxdoSuGANRAA0qL5IAkRWJDnD5k/617wVQ==
        caps mon = "allow *"
[client.admin]
        key = AQAnIxZoSkk6KhAASHgqFv3MOn6mAlGD6xZcfA==
        caps mds = "allow *"
        caps mgr = "allow *"
        caps mon = "allow *"
        caps osd = "allow *"
